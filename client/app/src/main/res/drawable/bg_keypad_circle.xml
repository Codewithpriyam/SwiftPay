<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D22D3EE">
    <item>
        <layer-list>
            <!-- Shadow Layer -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#0D000000" />
                    <padding android:bottom="2dp" />
                </shape>
            </item>
            
            <!-- Button Body -->
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:startColor="#26FFFFFF"
                        android:centerColor="#1AFFFFFF"
                        android:endColor="#14FFFFFF"
                        android:angle="135"/>
                    <stroke
                        android:width="1dp"
                        android:color="#33FFFFFF" />
                </shape>
            </item>

            <!-- Inner Light Highlight (Top edge) -->
            <item android:bottom="40dp">
                <shape android:shape="oval">
                    <solid android:color="#0DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
