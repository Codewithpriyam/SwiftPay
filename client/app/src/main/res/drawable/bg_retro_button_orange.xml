<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Diffuse outer glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#1AFF5722" />
        </shape>
    </item>

    <!-- Pill shaped gradient body -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="0"
                android:startColor="#FF5722"
                android:endColor="#FF9800"
                android:type="linear" />
            <stroke android:width="0.5dp" android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Subtle inner highlight -->
    <item android:top="2dp" android:left="10dp" android:right="10dp" android:bottom="35dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
