<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer extremely soft glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#08FFFFFF" />
        </shape>
    </item>

    <!-- Seamless glass circle -->
    <item android:left="4dp" android:right="4dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="0.5dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
