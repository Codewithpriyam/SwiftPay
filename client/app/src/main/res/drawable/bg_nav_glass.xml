<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid Shine Highlight (Top) -->
    <item>
        <shape>
            <corners android:radius="40dp" />
            <gradient
                android:startColor="#26FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
        </shape>
    </item>

    <!-- Frosted Body (Diffuse Light) -->
    <item android:top="1dp">
        <shape>
            <solid android:color="#40FFFFFF" /> <!-- 25% White diffusion -->
            <corners android:radius="40dp" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" /> <!-- Subtle edge glow -->
        </shape>
    </item>
</layer-list>
